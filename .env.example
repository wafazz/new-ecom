APP_NAME="Lure Shop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=lure_session
SESSION_LIFETIME=7200

CURRENCY=MYR
AFFILIATE_COOKIE_DAYS=30

# Bank transfer details are set on the admin Payments page; these three are only the starting values until you save them there.
BANK_NAME="Your Bank"
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_HOLDER="Your Company Sdn Bhd"
